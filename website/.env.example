# Vercel(Production)에 등록된 빌드 타임 환경변수 목록 (build.js가 소비).
# 새 var 추가 시 여기에도 기록 → "Vercel에 등록해야 한다"는 리마인더 겸 복구용 스냅샷.
# 값 변경 시 Vercel 대시보드에서 수정 후 재배포. 일반(config) 타입으로 등록할 것 — sensitive 금지.
#
# ⚠️ 값 기재 규칙: 여기 있는 값들은 전부 이미 퍼블릭임 (빌드된 HTML/assetlinks.json에
# 그대로 노출되는 웹 클라이언트 설정). 진짜 비밀(서버 키 등)은 애초에 이 사이트 빌드에
# 들어갈 수 없고, 만약 생기면 이름만 적고 값은 절대 기재하지 말 것.

# Android App Links (assetlinks.json 생성)
ANDROID_PACKAGE=app.getkozy.kozy
ANDROID_CERT_SHA256=E4:93:A1:7C:35:6E:BE:98:76:89:23:13:E1:45:93:2C:F3:6B:FF:EC:A5:55:9A:E0:EB:C8:DE:01:ED:0C:0F:12
# 디버그 keystore 지문 (dev 전용 — 정식 런칭 시 빈 값으로 설정해 제거)
# ANDROID_DEBUG_CERT_SHA256=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C

# iOS Universal Links (apple-app-site-association 생성)
APPLE_TEAM_ID=D9CF678753
IOS_BUNDLE_ID=app.getkozy.kozy

# Firebase (listing.html / auth-action.html 토큰 주입) — 웹 클라이언트 공개 설정값
FIREBASE_PROJECT_ID=kozy-prod-6fbdc
FIREBASE_API_KEY=AIzaSyCURITl0dXqtS1MMpHQwnwNcbJ1b-HxN8M
FIREBASE_AUTH_DOMAIN=kozy-prod-6fbdc.firebaseapp.com

