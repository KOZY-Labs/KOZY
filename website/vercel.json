{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/account-deletion", "destination": "/user-data", "statusCode": 308 },
    { "source": "/privacy", "destination": "/privacy-policy", "statusCode": 308 }
  ]
}
