<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Universal Links: https://getkozy.app/listing/* opens the app. Requires the
         Associated Domains capability on the provisioning profile (eas credentials
         will regenerate it once the Apple Developer account is ready). Mirrors
         app.json ios.associatedDomains. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
      <string>applinks:getkozy.app</string>
    </array>
    <!-- Push (expo-notifications). 'development' is correct here: release signing
         (App Store provisioning) swaps it to 'production' automatically — never
         hardcode 'production' (the JOOPI mistake, which broke dev-build push). -->
    <key>aps-environment</key>
    <string>development</string>
  </dict>
</plist>
