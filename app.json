{
  "expo": {
    "name": "KOZY",
    "slug": "kozy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kozy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "bundleIdentifier": "app.getkozy.kozy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow KOZY to access your location to show where you are on the listing map."
      },
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:getkozy.app"
      ]
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#2656FB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.getkozy.kozy",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getkozy.app",
              "pathPrefix": "/listing"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "organization": "kozy-labs",
          "project": "kozy"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Horizontal-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2656FB",
          "dark": {
            "backgroundColor": "#2656FB"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KOZY to access your photos so you can add images to your listing."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kozy-labs",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "854b4b93-cb0f-4a57-9039-2ebb824e9713"
      }
    }
  }
}
