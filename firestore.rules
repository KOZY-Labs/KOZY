rules_version = '2';

// KOZY Firestore security rules — derived from [ROLES] / [COLLECTIONS] in CLAUDE.md.
// Listings are publicly readable (guest browse). Writes require auth + ownership.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Reads the caller's user doc role. Only call where strictly needed (costs a read).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users — public profile read; only the user (or admin) can write their doc.
    // `verified` / `personaInquiryId` are server-only (Persona webhook via Admin SDK,
    // which bypasses rules). trustLevel 3 is derived from `verified`, so clients may
    // only write it once the server has already set verified.
    match /users/{uid} {
      function noServerOnlyFields() {
        // `persona` is the webhook's audit map; `personaInquiryId` is its legacy
        // flat predecessor — keep both blocked so clients can't fabricate either.
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'persona', 'personaInquiryId']);
      }
      function trustLevelAllowed() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['trustLevel'])
          || request.resource.data.trustLevel in [1, 2]
          || (request.resource.data.trustLevel == 3 && resource.data.verified == true);
      }

      allow read: if true;
      allow create: if isSelf(uid)
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('trustLevel', 1) in [1, 2]
        && !('persona' in request.resource.data)
        && !('personaInquiryId' in request.resource.data);
      allow update: if (isSelf(uid) || isAdmin())
        && noServerOnlyFields()
        && trustLevelAllowed();
      allow delete: if isSelf(uid) || isAdmin();

      // savedListings is private to the user.
      match /savedListings/{listingId} {
        allow read, write: if isSelf(uid);
      }
    }

    // listings — public read; owner-only create/update/delete.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // chats — only participants can read/write the chat and its messages.
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function willBeParticipant() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      // `get` must also allow the not-yet-existing case (resource == null): the client
      // checks for an existing chat before creating one, and evaluating
      // resource.data on a missing doc would otherwise fail with permission-denied.
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isParticipant();
      allow create: if willBeParticipant();
      allow update: if isParticipant() || isAdmin();
      allow delete: if isParticipant() || isAdmin();

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isSignedIn() && request.auth.uid in chatData().participants;
        allow create: if isSignedIn()
          && request.auth.uid in chatData().participants
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAdmin();
        // Participants may delete messages so deleting a chat can purge its thread.
        allow delete: if isAdmin()
          || (isSignedIn() && request.auth.uid in chatData().participants);
      }
    }

    // reports — signed-in users can file and read their own (the browse feed hides
    // listings the viewer reported); only admins can triage.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
