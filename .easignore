# .easignore — EAS 빌드 복사본에 무엇을 제외할지 결정한다.
# 이 파일이 있으면 eas-cli는 .gitignore를 무시하고 이 파일만 사용한다.
# .gitignore와의 차이: 빌드에 필요한 아래 세 파일은 제외하지 않는다.
#   - .env.local                       (EXPO_PUBLIC_* → JS 번들에 포함)
#   - android/app/google-services.json (google-services gradle 플러그인)
#   - android/sentry.properties        (Sentry 소스맵 업로드 인증)

# dependencies
node_modules/
functions/node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
**/.DS_Store

# secrets that the app build never needs
*serviceAccount*.json
*serviceaccount*.json
firebase-adminsdk*.json
credentials.json
credentials/

# local
*.log
expo-env.d.ts
*.md
/.claude
/.vscode
/.vercel
build/
website/
